```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled and build artifacts
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out

# Dependencies
.venv/
venv/
env/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Coverage
.coverage
coverage/
htmlcov/

# Editors
.vscode/
.idea/
*.swp
*.swo

# System
.DS_Store
Thumbs.db

# Build directories
dist/
build/
target/
.mypy_cache/
.pytest_cache/
```