# .env.example — пример файла окружения (НЕ коммитировать реальные токены)
# Скопируйте этот файл как `.env` и заполните значения перед запуском.

# Примечание:
# 1) Файл `.env` должен находиться в корне проекта и НЕ попадать в git.
# 2) Перед запуском сервисов убедитесь, что переменные заполнены корректно.# .env — Файл окружения для Postopus
# ⚠️ НИКОГДА не коммитьте этот файл в Git! Он уже в .gitignore.

# === VK TOKENS ===
# Основной токен (чтение + постинг)
VK_TOKEN_VALSTAN=

# Токен только для чтения
VK_TOKEN_VITA=

# Остальные токены (если нужны)
VK_TOKEN_OLGA=NONE
VK_TOKEN_ELIS=NONE
VK_TOKEN_ALEX=NONE
VK_TOKEN_MAMA=NONE
VK_TOKEN_DRAN=NONE

# === БАЗЫ ДАННЫХ ===
MONGO_CLIENT=

# === TELEGRAM ===
TELEGA_TOKEN_VALSTANBOT=
TELEGA_TOKEN_AFONYA=

# === YANDEX DISK ===
YANDEX_DISK_TOKEN=

# === ЛОГИНЫ/ПАРОЛИ ===
INSTA_LOGIN_MI=
INSTA_PASSWORD_MI=
TIKTOK_LOGIN_MI=
TIKTOK_PASSWORD_MI=
