# .env — Файл окружения для Postopus
# ⚠️ НИКОГДА не коммитьте этот файл в Git! Он уже в .gitignore.

# === VK TOKENS ===
# Основной токен (чтение + постинг)
VK_TOKEN_VALSTAN=

# Токен только для чтения
VK_TOKEN_VITA=

# Остальные токены (если нужны)
VK_TOKEN_OLGA=
VK_TOKEN_ELIS=
VK_TOKEN_ALEX=
VK_TOKEN_MAMA=
VK_TOKEN_DRAN=

# === БАЗЫ ДАННЫХ ===
MONGO_CLIENT=mongodb+srv://...

# === TELEGRAM ===
TELEGA_TOKEN_VALSTANBOT=
TELEGA_TOKEN_AFONYA=

# === YANDEX DISK ===
YANDEX_DISK_TOKEN=

# === ЛОГИНЫ/ПАРОЛИ ===
VK_LOGIN_DRAN=
VK_PASSWORD_DRAN=
INSTA_LOGIN_MI=
INSTA_PASSWORD_MI=
TIKTOK_LOGIN_MI=
TIKTOK_PASSWORD_MI=
